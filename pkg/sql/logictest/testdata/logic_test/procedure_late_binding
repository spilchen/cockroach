statement ok
CREATE VIEW v_dep AS SELECT a, b FROM t_vbase

statement ok
CREATE PROCEDURE p_view() LANGUAGE SQL AS $$ SELECT * FROM v_dep $$

# Procedure descriptor should have no dependsOn.
query T
SELECT COALESCE(
  d->'function'->'dependsOn',
  '[]'
) FROM (
  SELECT crdb_internal.pb_to_json('cockroach.sql.sqlbase.Descriptor', descriptor, false) d
  FROM system.descriptor
