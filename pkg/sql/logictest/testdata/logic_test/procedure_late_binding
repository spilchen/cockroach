subtest type_deps

# UDTs used in the procedure body should not get back-references.
statement ok
CREATE TYPE color AS ENUM ('red', 'green', 'blue')

statement ok
CREATE TABLE t_typed (a INT, c color)

statement ok
CREATE PROCEDURE p_type() LANGUAGE SQL AS $$ INSERT INTO t_typed VALUES (1, 'red'::color) $$

# Procedure descriptor should have no dependsOnTypes from the body.
# (Parameter/return type deps are still tracked, but this procedure has
# no UDT parameters.)
query T
SELECT COALESCE(
  d->'function'->'dependsOnTypes',
  '[]'
) FROM (
  SELECT crdb_internal.pb_to_json('cockroach.sql.sqlbase.Descriptor', descriptor, false) d
  FROM system.descriptor
) WHERE d->'function'->'name' = '"p_type"'
----
[]

# The type descriptor should have no back-reference from the procedure.
# Drop cascade would succeed because there's no dep from the procedure.
# But the table t_typed depends on color, so we test the procedure dep
# by checking that the type's back-references only include the table.
let $t_typed_id
SELECT 't_typed'::regclass::oid::int

let $p_type_id
SELECT (
  SELECT (d->'function'->'id')::INT FROM (
    SELECT crdb_internal.pb_to_json('cockroach.sql.sqlbase.Descriptor', descriptor, false) d
    FROM system.descriptor
  ) WHERE d->'function'->'name' = '"p_type"'
)

# Verify the type's back-references don't include the procedure ID.
query B
SELECT NOT EXISTS (
  SELECT 1
  FROM (
    SELECT jsonb_array_elements(
      COALESCE(d->'type'->'referencingDescriptorIds', '[]')
    )::TEXT::INT AS ref_id
    FROM (
      SELECT crdb_internal.pb_to_json('cockroach.sql.sqlbase.Descriptor', descriptor, false) d
      FROM system.descriptor
    )
    WHERE d->'type'->'name' = '"color"'
      AND d->'type'->>'enumMembers' IS NOT NULL
  ) sub
  WHERE ref_id = $p_type_id
)
----
true

statement ok
DROP TABLE t_typed

statement ok
DROP PROCEDURE p_type

statement ok
DROP TYPE color

subtest end

