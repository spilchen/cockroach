# LogicTest: local

# Enable late binding for routines.
statement ok
SET CLUSTER SETTING sql.routines.late_binding.enabled = true

subtest forward_reference_sql

# CREATE PROCEDURE should succeed even though t1 does not exist.
statement ok
CREATE PROCEDURE p_fwd() LANGUAGE SQL AS $$ SELECT * FROM t1 $$

# The procedure's dependsOn list should be empty (no back-references installed).
query T
SELECT COALESCE(
  d->'function'->'dependsOn',
  '[]'
) FROM (
  SELECT crdb_internal.pb_to_json('cockroach.sql.sqlbase.Descriptor', descriptor, false) d
  FROM system.descriptor
) WHERE d->'function'->'name' = '"p_fwd"'
----
[]

# CALL should fail because t1 does not exist yet.
statement error pgcode 42P01 relation "t1" does not exist
CALL p_fwd()

# Create the table and verify CALL now works.
statement ok
CREATE TABLE t1 (c1 INT)

statement ok
INSERT INTO t1 VALUES (1), (2)

statement ok
CALL p_fwd()

# The table should NOT have a back-reference to the procedure.
let $t1_id
SELECT 't1'::regclass::oid::int

query T
SELECT COALESCE(
  d->'table'->'dependedOnBy',
  '[]'
) FROM (
  SELECT crdb_internal.pb_to_json('cockroach.sql.sqlbase.Descriptor', descriptor, false) d
  FROM system.descriptor
  WHERE id = $t1_id
)
----
[]

statement ok
DROP TABLE t1

statement ok
DROP PROCEDURE p_fwd

subtest end

